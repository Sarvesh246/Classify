# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & e2e artifacts
/coverage
/test-results/
/playwright-report/
/blob-report/

# local tooling / scratch (never deploy)
.playwright-cli/
/output/
.tmp/
devserver.log
/tmp-*.png

# Cursor IDE — machine-local hook state only (not shared project config)
.cursor/hooks/state/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-dev.log
debug-*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class

# ETL outputs (generated; not app runtime on Vercel)
/etl/output/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
